# Copy this file to .env and fill in the values you need.
# It is read by the Node server (server/src/config.js); the Python scraper
# is configured by the server, so it needs nothing of its own.

# ------------------------------------------------------------------
# LLM provider for the AI Assistant.
# Set LLM_PROVIDER to "gemini" or "openai" and fill in the matching
# keys below. Only the selected provider's key is required.
# ------------------------------------------------------------------

LLM_PROVIDER=gemini

# -- Gemini (https://aistudio.google.com/apikey) --
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# -- OpenAI-compatible (OpenAI, Groq, a local Ollama/vLLM server, etc.) --
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# ------------------------------------------------------------------
# Sign-in (Google) and the database
# ------------------------------------------------------------------

# REQUIRED. The OAuth "Web application" client ID from Google Cloud Console
# (APIs & Services > Credentials). It is public, not a secret. See the README
# section "Google sign-in" for the 5-minute setup. Who may sign in is decided
# by the list in server/src/allowedEmails.js.
GOOGLE_CLIENT_ID=

# SQLite file with accounts, sessions and each person's search history.
# DATABASE_PATH=./data/iudicium.db

# How long a sign-in lasts, in days.
# SESSION_DAYS=7

# Set to "true" only when the server sits behind a reverse proxy / load
# balancer that terminates HTTPS (Cloud Run, nginx).
# TRUST_PROXY=true

# ------------------------------------------------------------------
# Scraper options
# ------------------------------------------------------------------

# Python used to start the scraper worker. If unset, the active virtual
# environment or a .venv/venv folder in the project is used, otherwise
# "python" (Windows) / "python3". It must have the packages from
# requirements.txt installed. Example (Windows venv):
# PYTHON_BIN=C:/path/to/iudicium/.venv/Scripts/python.exe

# Path to the tesseract binary. Leave blank to auto-detect the usual
# install location for your OS (or whatever is on your PATH).
TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe

# Run the browser headless (recommended on a server without a display).
# Set to "false" to watch the browser locally.
SCRAPER_HEADLESS=true

# Use synthetic data instead of the live court website. Handy for working
# on the UI without solving real CAPTCHAs. Only the exact value "true" turns it on.
# SCRAPER_MOCK=true

# After you press Stop, how long (ms) the scraper gets to finish its current
# step and save results before it is killed.
# STOP_GRACE_MS=60000

# ------------------------------------------------------------------
# Web server
# ------------------------------------------------------------------

HOST=127.0.0.1
PORT=8000

# Where workbooks, zips, judgment PDFs and debug snapshots are written.
# OUTPUT_DIR=./outputs
